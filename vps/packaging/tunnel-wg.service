[Unit]
Description=tunnel-wg control plane
Documentation=https://github.com/tunnel-wg/tunnel-wg
After=network-online.target wg-quick@wg0.service tunnel-wg-firewall.service
Wants=network-online.target
Requires=wg-quick@wg0.service tunnel-wg-firewall.service

[Service]
Type=simple
ExecStart=/usr/local/bin/tunnel-wg serve
Restart=on-failure
RestartSec=3s
TimeoutStopSec=10s
User=root
UMask=0077

# Hardening. The service only needs netlink and nftables access.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
ReadWritePaths=/etc/tunnel-wg /var/lib/tunnel-wg /run/tunnel-wg /etc/wireguard

# Small footprint.
MemoryHigh=48M
MemoryMax=96M
TasksMax=64
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
