[Unit]
Description=umbrel-tunnel control plane
Documentation=https://github.com/AlbercoinDev/umbrel-tunnel
After=network-online.target wg-quick@wg0.service umbrel-tunnel-firewall.service
Wants=network-online.target
Requires=wg-quick@wg0.service umbrel-tunnel-firewall.service

[Service]
Type=simple
ExecStart=/usr/local/bin/umbrel-tunnel serve
Restart=on-failure
RestartSec=3s
TimeoutStopSec=10s
User=root
UMask=0077

# Hardening. The service only needs netlink and nftables access.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
ReadWritePaths=/etc/umbrel-tunnel /var/lib/umbrel-tunnel /run/umbrel-tunnel /etc/wireguard

# Small footprint.
MemoryHigh=48M
MemoryMax=96M
TasksMax=64
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
